# Use :80 for plain HTTP by IP address. For automatic HTTPS, use a domain
# pointed at this server (for example, lci.example.com).
SITE_ADDRESS=:80

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-different-random-hex-secret

POSTGRES_USER=lci
POSTGRES_DB=lci
JWT_EXPIRATION_MINUTES=60
LLM_PROVIDER=none
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
